  "packageManager": "pnpm@10.33.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@payloadcms/ui@3.77.0": "patches/@payloadcms__ui@3.77.0.patch",
      "payload-sidebar-plugin": "patches/payload-sidebar-plugin.patch"
    }
  }
}
