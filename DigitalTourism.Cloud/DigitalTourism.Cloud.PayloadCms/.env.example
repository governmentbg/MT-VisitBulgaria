# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Analytics 4 (GA4) Configuration
# Measurement ID for client-side tracking (gtag.js)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Property ID for GA4 Data API (server-side analytics)
GA4_PROPERTY_ID=123456789

# Service account credentials JSON (single line) for GA4 Data API
# Create a service account in Google Cloud Console with Analytics Viewer role
GA4_CREDENTIALS_JSON={"type":"service_account",...}

# Keycloak Backoffice Service Account (for admin user management sync)
KEYCLOAK_BACKOFFICE_SERVICE_CLIENT_ID=digitaltourism-cms-service
KEYCLOAK_BACKOFFICE_SERVICE_SECRET=your-secret-here

# Weather API Configuration
# API key from weatherapi.com (free tier: 3-day forecast)
WEATHER_API_KEY=your_weatherapi_key_here
