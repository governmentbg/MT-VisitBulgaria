{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-attractions-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/attractions/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/attractions/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-events-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/events/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/events/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-hotels-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/hotels/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/hotels/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-restaurants-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/restaurants/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/restaurants/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-activities-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/activities/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/activities/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-cities-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/cities/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/cities/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "keycloak-realms-route": {
        "ClusterId": "keycloak-cluster",
        "Match": {
          "Path": "/auth/realms/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "api-media-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/media/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/media/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "api-settings-route": {
        "ClusterId": "api-service-cluster",
        "Match": {
          "Path": "/api/v1/settings/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/v1/settings/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
    },
    "Clusters": {
      "api-service-cluster": {
        "Destinations": {
          "api-service": {
            "Address": "http://api-service"
          }
        }
      },
      "keycloak-cluster": {
        "Destinations": {
          "keycloak": {
            "Address": "http://keycloak"
          }
        }
      }
    }
  }
}
