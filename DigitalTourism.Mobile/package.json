{
  "name": "VisitBulgaria",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "cross-env ENVFILE=.env.dev react-native run-android",
    "adb:reverse": "node scripts/adb-reverse.js",
    "android:dev": "node scripts/adb-reverse.js && cross-env ENVFILE=.env.dev react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android:staging": "cross-env ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "cross-env ENVFILE=.env.production react-native run-android --mode=productionDebug",
    "ios": "cross-env ENVFILE=.env.dev react-native run-ios --scheme VisitBulgaria-Dev",
    "ios:dev": "cross-env ENVFILE=.env.dev react-native run-ios --scheme VisitBulgaria-Dev",
    "ios:staging": "cross-env ENVFILE=.env.staging react-native run-ios --scheme VisitBulgaria-Staging",
    "ios:prod": "cross-env ENVFILE=.env.production react-native run-ios --scheme VisitBulgaria-Production",
    "lint": "eslint .",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "test": "jest",
    "generate:mockdata": "node scripts/generateMockData.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
