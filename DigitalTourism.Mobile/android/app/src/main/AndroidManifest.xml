<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:supportsRtl="true">
    <meta-data
      android:name="com.google.android.geo.API_KEY"
      android:value="${GOOGLE_MAPS_API_KEY}" />

    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:theme="@style/BootTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        Android App Links — for HTTPS deep links from shared entity URLs.

        NOTE 1: We deliberately do NOT add a <data android:scheme="${DEEP_LINK_SCHEME}" />
        intent-filter here. That custom scheme is already claimed by
        react-native-app-auth's RedirectUriReceiverActivity (via the
        `appAuthRedirectScheme` manifest placeholder in build.gradle) for the
        Keycloak OAuth callback. Adding a second filter for the same scheme on
        MainActivity would cause Android to show an "Open with" chooser on
        every login redirect.

        NOTE 2: `android:autoVerify="true"` is intentionally OMITTED until
        assetlinks.json is deployed on visitbulgaria.com/.site. With it on but
        no valid association file, Android repeatedly attempts verification on
        each app start, which has been observed to destabilise Chrome Custom
        Tabs pre-warming and the OAuth callback flow. Re-enable autoVerify
        once the association files are live and Google's Digital Asset Links
        tester passes.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" />
        <data android:host="visitbulgaria.com" />
        <data android:host="visitbulgaria.site" />
      </intent-filter>
    </activity>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
